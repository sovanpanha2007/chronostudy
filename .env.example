# Copy to .env.local and use values from `npx supabase status` for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# Never put a service-role key, secret key, or Google client secret in NEXT_PUBLIC_*.
